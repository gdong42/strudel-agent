{
  "trackFile": "tracks/main.strudel.js",
  "snapshots": {
    "directory": "snapshots",
    "maxCount": 50,
    "maxAgeHours": 24
  },
  "agent": {
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "contextFile": "agent-context.md",
    "runtime": {
      "maxTurns": 8,
      "maxElapsedSeconds": 900,
      "maxTotalTokens": 4000000,
      "maxOutputTokensPerTurn": 65536
    }
  },
  "samples": {
    "registryPath": "samples"
  },
  "server": {
    "host": "127.0.0.1",
    "port": 8787
  }
}
