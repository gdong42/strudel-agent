{
  "name": "strudel-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:mock": "playwright test --config e2e/playwright.config.ts e2e/mock-repl.spec.ts"
  },
  "dependencies": {
    "@fontsource-variable/mona-sans": "5.3.0",
    "@fontsource/monaspace-neon": "5.3.0",
    "@strudel/mini": "1.2.6",
    "@strudel/repl": "1.3.0",
    "acorn": "8.17.0",
    "dompurify": "3.4.13",
    "estree-walker": "3.0.3",
    "lucide": "1.29.0",
    "marked": "18.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
