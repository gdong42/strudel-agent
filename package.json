{
  "name": "strudel-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:mock": "playwright test --config e2e/playwright.config.ts e2e/mock-repl.spec.ts"
  },
  "dependencies": {
    "@strudel/repl": "1.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9",
    "vite": "^5.4.11"
  }
}
